{
  "name": "rec-take-home",
  "private": true,
  "packageManager": "bun@1.3.13",
  "workspaces": ["admin", "web", "data"],
  "scripts": {
    "dev": "bun run --parallel dev:admin dev:web",
    "dev:admin": "bun run --cwd admin dev",
    "dev:web": "bun run --cwd web dev",
    "build": "bun run --cwd admin build && bun run --cwd web build",
    "seed": "bun run --cwd data seed"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.8.3"
  }
}
